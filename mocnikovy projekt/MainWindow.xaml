<Window x:Class="mocnikovy_projekt.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Útěk z domova" Height="1080" Width="1920" WindowState="Maximized" WindowStyle="None" Background="Black">
    <Grid>
        <Canvas x:Name="MenuScene" Visibility="Visible">
            <Image Source="/titstulnistranka.png" Width="1920" Height="1080" Stretch="Fill"/>
            <StackPanel Canvas.Left="690" Canvas.Top="660">
                <Button Content="NOVÁ HRA" Click="StartGame_Click" Width="505" Height="103" FontSize="40" Background="#FFE6C391" Opacity="0"/>
                <Button Content="NASTAVENÍ" Click="OpenSettings_Click" Width="505" Height="103" FontSize="40" Margin="0,10" Background="#FFE6C391" Opacity="0"/>
                <Button Content="KONEC" Click="Exit_Click" Width="498" Height="83" FontSize="40" Background="#FFE6C391" Opacity="0"/>
            </StackPanel>
        </Canvas>

        <Canvas x:Name="Scene1" Visibility="Collapsed">
            <Image x:Name="RoomBackground" Source="/pokkoj.png" Width="1920" Height="1080" Stretch="Fill"/>
            <Rectangle Fill="Transparent" Width="622" Height="170" Canvas.Left="338" Canvas.Top="476" MouseDown="Bed_Click" Cursor="Hand"/>
            <Rectangle Fill="Transparent" Width="536" Height="464" Canvas.Left="1284" Canvas.Top="280" MouseDown="PC_Click" Cursor="Hand"/>
            <Rectangle Fill="Transparent" Width="100" Height="1080" Canvas.Left="1820" MouseDown="GoToBathroom_Click" Cursor="Hand"/>
            <Rectangle Fill="Transparent" Width="237" Height="476" Canvas.Left="39" Canvas.Top="604" MouseDown="Cage_Click" Cursor="Hand"/>
            <Rectangle Fill="Transparent" Width="126" Height="120" Canvas.Left="185" Canvas.Top="501" MouseDown="Pillow_Click" Cursor="Hand"/>
            <Rectangle x:Name="aojadhagfuawhguhwRGHwroghpiWRGHIPwrphpgw" Height="131" Canvas.Left="1312" Stroke="Black" Canvas.Top="351" Visibility="Collapsed" Width="247" Fill="Black" HorizontalAlignment="Left" VerticalAlignment="Center"/>
            <TextBlock x:Name="abcd" Visibility="Collapsed" Canvas.Left="1322" TextWrapping="Wrap" Text="{Binding Code}" FontSize="40" TextAlignment="Center" Foreground="LawnGreen" Canvas.Top="378" Height="91" Width="230" HorizontalAlignment="Left" VerticalAlignment="Center"/>
        </Canvas>

        <Canvas x:Name="Scene2" Visibility="Collapsed">
            <Image Source="/knoupelna.png" Width="1920" Height="1080" Stretch="Fill"/>
            <Image x:Name="sejf" Source="/sejf.png" Width="1920" Visibility="Collapsed"/>
            <Rectangle x:Name="Safe_Hitbox" Fill="Transparent" Width="352" Height="140" Canvas.Left="571" Canvas.Top="800" MouseDown="Safe_Click" Cursor="Hand" Visibility="Collapsed"/>
            <Rectangle Fill="Transparent" Width="217" Height="146" Canvas.Left="413" Canvas.Top="280" MouseDown="Cabinet_Click" Cursor="Hand"/>
            <Rectangle Fill="Transparent" Width="900" Height="260" Canvas.Left="950" Canvas.Top="280" MouseDown="Bath_Click" Cursor="Hand"/>
            <Rectangle x:Name="Tile_Zone" Fill="Transparent" Width="316" Height="112" Canvas.Left="507" Canvas.Top="891" MouseDown="Tile_Click" Cursor="Hand"/>
            <Rectangle Fill="Transparent" Width="100" Height="1080" Canvas.Left="0" MouseDown="GoToRoom_Click" Cursor="Hand"/>
        </Canvas>

        <Border x:Name="NotificationPanel" Background="Black" Opacity="0.8" Height="120" VerticalAlignment="Top" Visibility="Collapsed">
            <TextBlock x:Name="NotificationText" Foreground="White" FontSize="30" HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Border>

        <Border x:Name="SettingsPanel" Visibility="Collapsed" Background="Black" Opacity="0.95">
            <Grid>
                <TextBlock Text="NASTAVENÍ" Foreground="White" FontSize="50" Margin="828,426,828,577"/>
                <Button Content="ZPĚT" Click="CloseSettings_Click" Width="200" Height="58" Margin="860,649,860,373"/>
                <TextBlock TextWrapping="Wrap" Foreground="White" FontSize="25" Text="Ahoj :) Nic tady není. " Margin="828,527,828,489" TextAlignment="Center"/>
            </Grid>

        </Border>
    </Grid>
</Window>